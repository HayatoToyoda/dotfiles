.DS_Store

# Claude Code runtime state — must never be committed.
# (install.sh uses per-item symlinks, so these normally stay in the real
# ~/.claude; entries kept as a safety net.)
.claude/.credentials.json
.claude/settings.local.json
.claude/history.jsonl
.claude/stats-cache.json
.claude/session-env/
.claude/sessions/
.claude/file-history/
.claude/paste-cache/
.claude/shell-snapshots/
.claude/statsig/
.claude/telemetry/
.claude/todos/
.claude/tasks/
.claude/plans/
.claude/downloads/
.claude/plugins/
.claude/ide/
.claude/projects/
.claude/cache/
.claude/debug/
.claude/backups
